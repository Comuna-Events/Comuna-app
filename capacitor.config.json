{
  "appId": "com.wearecomuna.app",
  "appName": "Comuna",
  "webDir": "ios-web",
  "ios": {
    "contentInset": "never",
    "scheme": "Comuna"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#244D3A",
      "showSpinner": false
    },
    "PushNotifications": {
      "presentationOptions": [
        "banner",
        "sound",
        "list"
      ]
    },
    "SocialLogin": {
      "providers": {
        "apple": true,
        "google": true,
        "facebook": false,
        "twitter": false
      }
    }
  }
}
