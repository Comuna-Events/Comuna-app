{
  "name": "comuna",
  "private": true,
  "description": "Comuna's iPhone and Android apps: the web app in index.html, packaged with Capacitor. See IOS.md and ANDROID.md.",
  "scripts": {
    "ios": "node scripts/build-ios.mjs && cap sync ios",
