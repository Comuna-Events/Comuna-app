    "android": "node scripts/build-ios.mjs && cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/geolocation": "8.2.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@capgo/capacitor-social-login": "8.5.17"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@fontsource/big-shoulders-display": "5.3.0",
    "@fontsource/caveat": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/patrick-hand-sc": "5.3.0",
    "@supabase/supabase-js": "2.45.4"
  }
